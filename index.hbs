<!doctype html>
<html lang="fr">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Grenoble avant/après</title>
  <meta name="description" content="Trouvez où c'est dans Grenoble. Restez appuyé sur la photo pour la réponse." />
  <link rel="canonical" href="https://grenoble.donias.fr" />
  <meta property="og:title" content="Grenoble avant/après" />
  <meta property="og:description" content="Trouvez où c'est dans Grenoble. Restez appuyé sur la photo pour la réponse." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://grenoble.donias.fr" />
  <meta property="og:image" content="https://grenoble.donias.fr/img/jauresvizille.jpg" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="icon" href="img/jauresvizille.jpg" />
  <style>
    :root {
      /* Background & surfaces */
      --bg: #ede5d8;
      --surface: #faf6f0;
      --surface-tint: #f3ece0;

      /* Text */
      --text: #1c1710;
      --text-muted: #7a6a58;
      --text-subtle: #a8957e;

      /* Accents */
      --red: #bf2c0e;
      --navy: #1a3356;

      /* Badges */
      --badge-then-bg: #bf2c0e;
      --badge-then-text: #fff;
      --badge-now-bg: #1a3356;
      --badge-now-text: #fff;

      /* Cards */
      --card-bg: #fdfaf5;
      --card-shadow:
        0 2px 3px rgba(0, 0, 0, 0.12),
        0 8px 18px rgba(0, 0, 0, 0.18),
        0 24px 48px rgba(0, 0, 0, 0.14);

      /* Misc */
      --focus-ring: #bf2c0e;
      --title-font: Georgia, 'Times New Roman', serif;
      --body-font: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      --divider: rgba(80, 55, 30, 0.2);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--body-font);
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 56px 32px 72px;
    }

    @media (max-width: 480px) {
      body {
        padding: 28px 6px 40px;
      }

      .gallery {
        padding: 0;
        gap: 28px;
      }
    }

    .container {
      position: relative;
      z-index: 0;
      width: min(860px, 100%);
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 48px;
    }

    h1 {
      font-family: var(--title-font);
      font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
      font-weight: 400;
      font-style: italic;
      margin: 0 0 2px;
      letter-spacing: -1px;
      color: var(--text);
      line-height: 1;
    }

    .tagline {
      font-size: clamp(0.7rem, 0.5rem + 0.6vw, 0.82rem);
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--red);
      font-weight: 600;
      margin: 0 0 32px;
    }

    .steps {
      display: inline-flex;
      flex-direction: column;
      gap: 8px;
      text-align: left;
      background: var(--surface-tint);
      border-top: 2px solid var(--text);
      border-bottom: 1px solid var(--divider);
      padding: 14px 24px;
    }

    .step {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border: 1.5px solid var(--divider);
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--text-subtle);
      flex-shrink: 0;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      gap: 48px;
      padding: 0 24px;
      list-style: none;
    }

    .card {
      background: var(--card-bg);
      padding: 10px 10px 28px;
      box-shadow: var(--card-shadow);
      outline: none;
      cursor: pointer;
      user-select: none;
    }

    .card:nth-child(10n+1)  { transform: rotate(-0.7deg); }
    .card:nth-child(10n+2)  { transform: rotate(0.4deg); }
    .card:nth-child(10n+3)  { transform: rotate(-0.3deg); }
    .card:nth-child(10n+4)  { transform: rotate(0.6deg); }
    .card:nth-child(10n+5)  { transform: rotate(-0.5deg); }
    .card:nth-child(10n+6)  { transform: rotate(0.2deg); }
    .card:nth-child(10n+7)  { transform: rotate(-0.8deg); }
    .card:nth-child(10n+8)  { transform: rotate(0.4deg); }
    .card:nth-child(10n+9)  { transform: rotate(-0.3deg); }
    .card:nth-child(10n+10) { transform: rotate(0.7deg); }

    .card-image {
      position: relative;
      overflow: hidden;
      display: block;
      line-height: 0;
    }

    .card-image img {
      display: block;
      width: 100%;
      height: auto;
      cursor: default;
    }

    .card-image .alt {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity .15s ease-in-out;
      pointer-events: none;
    }

    .card.holding .alt {
      opacity: 1;
    }

    .card.holding {
      cursor: default;
    }

    @media (hover: none) {
      .card {
        cursor: default;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
      }
    }

    .card:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 3px;
    }

    .card-labels {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 6px 2px;
    }

    .badge {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-family: var(--body-font);
      pointer-events: none;
      transition: opacity 0.15s ease;
    }

    .badge-then {
      color: var(--badge-then-bg);
      opacity: 1;
    }

    .badge-now {
      color: var(--badge-now-bg);
      opacity: 0.25;
    }

    .card.holding .badge-then {
      opacity: 0.25;
    }

    .card.holding .badge-now {
      opacity: 1;
    }

  </style>
  <script>
    var _paq = window._paq = window._paq || [];
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="//analytics.donias.fr/";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '7']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
</head>

<body>
  <div class="container">
    <header class="header">
      <h1>Grenoble</h1>
      <p class="tagline">avant &nbsp;/&nbsp; après</p>
      <div class="steps">
        <div class="step"><span class="step-num">1</span>Trouvez où c'est dans Grenoble</div>
        <div class="step"><span class="step-num">2</span>Restez appuyé sur la photo pour la réponse</div>
      </div>
    </header>

    <ul class="gallery" role="list">
      {{#each pictures}}
      <li class="card" tabindex="0">
        <div class="card-image">
          <img class="base" src="img/{{this.then}}" />
          <img class="alt" aria-hidden="true" src="img/{{this.now}}" />
        </div>
        <div class="card-labels">
          <span class="badge badge-then">Avant</span>
          <span class="badge badge-now">Après</span>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>

  <script>
    const attachBehavior = () => {
      const cards = document.querySelectorAll('.card')

      const addHolding = (el) => el.classList.add('holding')
      const removeHolding = (el) => el.classList.remove('holding')

      cards.forEach((card) => {
        card.querySelectorAll('img').forEach(img => {
          img.addEventListener('contextmenu', event => {
            event.preventDefault()
            event.stopPropagation()
            event.cancelBubble = true
            event.returnValue = false
            return false
          })
        })

        card.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') e.preventDefault()
          card.setPointerCapture?.(e.pointerId)
          addHolding(card)
        })

        const end = () => removeHolding(card)
        card.addEventListener('pointerup', end)
        card.addEventListener('pointercancel', end)
        card.addEventListener('pointerleave', end)

        card.addEventListener('keydown', (e) => {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault()
            addHolding(card)
          }
        })
        card.addEventListener('keyup', (e) => {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault()
            removeHolding(card)
          }
        })
      })
    }

    ;(function () {
      const canvas = document.createElement('canvas')
      canvas.width = 150
      canvas.height = 150
      const ctx = canvas.getContext('2d')
      const img = ctx.createImageData(150, 150)
      for (let i = 0; i < img.data.length; i += 4) {
        const v = Math.random() * 255 | 0
        img.data[i]     = v
        img.data[i + 1] = v * 0.75 | 0
        img.data[i + 2] = v * 0.35 | 0
        img.data[i + 3] = 35
      }
      ctx.putImageData(img, 0, 0)
      document.body.style.backgroundImage = `url(${canvas.toDataURL()})`
    })()

    attachBehavior()

    window.addEventListener('load', () => {
      document.querySelectorAll('.card .alt').forEach((img) => {
        const preload = new Image()
        preload.src = img.src
      })
    });
  </script>
</body>

</html>
