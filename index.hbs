<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Grenoble avant/après</title>
  <meta property="og:title" content="Grenoble avant/après" />
  <meta property="og:description" content="Trouvez où c'est dans Grenoble. Restez appuyé sur la photo pour la réponse." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://grenoble.donias.fr" />
  <meta property="og:image" content="https://grenoble.donias.fr/img/jauresvizille.jpg" />
  <link rel="icon" href="img/jauresvizille.jpg" />
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
      background: #0c0e13;
      background-image: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(80, 110, 170, 0.1) 0%, transparent 70%);
      color: #e2e8f0;
      min-height: 100vh;
      padding: 48px 32px 64px;
    }

    .container {
      width: min(860px, 100%);
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 40px;
    }

    h1 {
      font-size: clamp(2rem, 1.2rem + 3vw, 3.2rem);
      font-weight: 800;
      margin: 0 0 6px;
      letter-spacing: -1px;
      background: linear-gradient(160deg, #e2e8f0 30%, #8eaed4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .tagline {
      font-size: clamp(0.75rem, 0.5rem + 0.8vw, 0.9rem);
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0 0 28px;
    }

    .steps {
      display: inline-flex;
      flex-direction: column;
      gap: 6px;
      text-align: left;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 12px;
      padding: 14px 20px;
    }

    .step {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.88rem;
      color: #94a3b8;
    }

    .step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      font-size: 0.72rem;
      font-weight: 700;
      color: #cbd5e1;
      flex-shrink: 0;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 0;
      list-style: none;
    }

    .card {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      background: #13171e;
      border: 1px solid rgba(255, 255, 255, 0.07);
      box-shadow: 0 8px 32px rgba(0, 0, 0, .5);
      outline: none;
      cursor: pointer;
      user-select: none;
    }

    .card img {
      display: block;
      width: 100%;
      height: auto;
      cursor: default;
    }

    .card .alt {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity .15s ease-in-out;
      pointer-events: none;
    }

    .card.holding .alt {
      opacity: 1;
    }

    .card.holding {
      cursor: default;
    }

    @media (hover: none) {
      .card {
        cursor: default;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
      }
    }

    .card:focus-visible {
      outline: 2px solid #6aa9ff;
      outline-offset: 2px;
    }

    .badge {
      position: absolute;
      top: 12px;
      padding: 4px 11px;
      border-radius: 20px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      pointer-events: none;
      transition: opacity 0.15s ease;
      backdrop-filter: blur(6px);
    }

    .badge-then {
      left: 12px;
      background: rgba(216, 163, 82, 0.85);
      color: #1a1200;
      opacity: 1;
    }

    .badge-now {
      right: 12px;
      background: rgba(96, 165, 250, 0.85);
      color: #00111f;
      opacity: 0;
    }

    .card.holding .badge-then {
      opacity: 0;
    }

    .card.holding .badge-now {
      opacity: 1;
    }

    .card-hint {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 40px 16px 14px;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
      text-align: center;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      pointer-events: none;
      transition: opacity 0.15s ease;
    }

    .card.holding .card-hint {
      opacity: 0;
    }
  </style>
</head>

<body>
  <div class="container">
    <header class="header">
      <h1>Grenoble</h1>
      <p class="tagline">avant &nbsp;/&nbsp; après</p>
      <div class="steps">
        <div class="step"><span class="step-num">1</span>Trouvez où c'est dans Grenoble</div>
        <div class="step"><span class="step-num">2</span>Restez appuyé sur la photo pour la réponse</div>
      </div>
    </header>

    <ul class="gallery">
      {{#each pictures}}
      <li class="card" tabindex="0">
        <img class="base" src="img/{{this.then}}" />
        <img class="alt" aria-hidden="true" src="img/{{this.now}}" />
        <span class="badge badge-then">Avant</span>
        <span class="badge badge-now">Après</span>
        <div class="card-hint">Maintenez appuyé pour révéler</div>
      </li>
      {{/each}}
    </ul>
  </div>

  <script>
    const attachBehavior = () => {
      const cards = document.querySelectorAll('.card')

      const addHolding = (el) => el.classList.add('holding')
      const removeHolding = (el) => el.classList.remove('holding')

      cards.forEach((card) => {
        card.querySelectorAll('img').forEach(img => {
          img.addEventListener('contextmenu', event => {
            event.preventDefault()
            event.stopPropagation()
            event.cancelBubble = true
            event.returnValue = false
            return false
          })
        })

        card.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') e.preventDefault()
          card.setPointerCapture?.(e.pointerId)
          addHolding(card)
        })

        const end = () => removeHolding(card)
        card.addEventListener('pointerup', end)
        card.addEventListener('pointercancel', end)
        card.addEventListener('pointerleave', end)

        card.addEventListener('keydown', (e) => {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault()
            addHolding(card)
          }
        })
        card.addEventListener('keyup', (e) => {
          if (e.code === 'Space' || e.code === 'Enter') {
            e.preventDefault()
            removeHolding(card)
          }
        })
      })
    }

    attachBehavior()

    window.addEventListener('load', () => {
      document.querySelectorAll('.card .alt').forEach((img) => {
        const preload = new Image()
        preload.src = img.src
      })
    });
  </script>
</body>

</html>
